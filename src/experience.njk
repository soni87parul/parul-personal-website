---
title: "Experience | Parul Soni Manvati"
layout: layouts/base.njk
seoTitle: "Experience | Parul Soni Manvati"
seoDescription: "A career is more useful when you can see the problems behind the titles. Explore Parul Soni Manvati's experience by capability: strategy, transformation, technology, operations, capital and policy."
---
{% import "partials/experience-card.njk" as cards %}
{% import "partials/recommendation-card.njk" as recs %}
{% import "partials/media-placeholder.njk" as media %}
{% import "partials/company-logo.njk" as companyLogo %}

<section class="page-header page-header--tight">
  <div class="wrap grid-12">
    <div class="col-6">
      <span class="eyebrow">{{ experiencePage.eyebrow }}</span>
      <h1>{{ experiencePage.headline }}</h1>
      <p>{{ experiencePage.supportingStatement }}</p>
      {% if experiencePage.explanationParagraphs.length %}
      <p style="margin-top: 1rem; max-width: 62ch; color: var(--muted); font-size: 1rem;">{{ experiencePage.explanationParagraphs[0] }}</p>
      {% endif %}
    </div>
    <div class="col-6">
      {{ media.placeholder("Systems, infrastructure and transformation across a career", "16/9", "A systems / network / operations-architecture visual, not stock photography.") }}
    </div>
  </div>
</section>

{% set snapdealFlagship = "snapdeal-same-day-next-day" | experienceByRef(collections.experienceStories) %}
{% set snapdealMore = "snapdeal-supply-chain-recovery" | experienceByRef(collections.experienceStories) %}
{% set amazonFlagship = "amazon-ai-ml-transformation" | experienceByRef(collections.experienceStories) %}
{% set addverbFlagship = "addverb-enterprise-transformation" | experienceByRef(collections.experienceStories) %}
{% set addverbCeoOffice = "addverb-ceo-office-rhythm" | experienceByRef(collections.experienceStories) %}
{% set addverbSupply = "addverb-semiconductor-supply" | experienceByRef(collections.experienceStories) %}
{% set clearmeatBusiness = "clearmeat-business-model" | experienceByRef(collections.experienceStories) %}
{% set clearmeatRegulatory = "clearmeat-building-emerging-category" | experienceByRef(collections.experienceStories) %}
{% set clearmeatSales = "clearmeat-techno-commercial-sales" | experienceByRef(collections.experienceStories) %}
{% set clearmeatVendor = "clearmeat-vendor-operations-portal" | experienceByRef(collections.experienceStories) %}
{% set systemFlagship = "abwci-msme-service-engine" | experienceByRef(collections.experienceStories) %}
{% set systemMarket = "abwci-digital-market-access" | experienceByRef(collections.experienceStories) %}
{% set systemUnctad = "unctad-abwci-digital-capacity-building" | experienceByRef(collections.experienceStories) %}

<section class="tier-dominant">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">The Journey</span>
      <h2>Increasing complexity, one connecting thread.</h2>
    </div>

    <div class="journey-scroll">
      <div class="journey-track">

        <div class="milestone milestone--foundation">
          {{ companyLogo.logo({ name: "DHL Express", color: "#D40511", logo: "/assets/images/uploads/logos/dhl-express.svg" }) }}
          <span class="milestone__company">Foundation · DHL Express &amp; ICICI Bank</span>
          <span class="milestone__title">Learning the customer and commercial reality</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand Foundation</span></summary>
            <div class="milestone__panel">
              <p>Early career at DHL Express and ICICI Bank built the fundamentals everything after it relies on: understanding the customer, commercial discipline, frontline execution, and how businesses actually operate day to day.</p>
            </div>
          </details>
        </div>

        {% if snapdealFlagship %}
        <div class="milestone milestone--snapdeal">
          {{ companyLogo.logo({ name: "Snapdeal", color: "#E4002B", logo: "/assets/images/uploads/logos/snapdeal.svg" }) }}
          <span class="milestone__company">Snapdeal{% if snapdealFlagship.data.year_or_period %} · {{ snapdealFlagship.data.year_or_period }}{% endif %}</span>
          <span class="milestone__title">Building speed and operational foundations</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand Snapdeal</span></summary>
            <div class="milestone__panel">
              <p>{{ snapdealFlagship.data.summary }}</p>
              <a href="{{ snapdealFlagship.url }}">Explore the transformation →</a>
              {% if snapdealMore %}
              {% set snapMoreImpact = snapdealMore.data.impact | publicImpact %}
              {% if snapMoreImpact.length %}
              <div class="metric-block" style="margin: 0.75rem 0;">
                <span class="metric-block__value" style="--metric-accent: var(--terracotta); font-size: 1.5rem;">{{ snapMoreImpact[0].value }}</span>
                <span class="metric-block__label">{{ snapMoreImpact[0].label }}: <a href="{{ snapdealMore.url }}">{{ snapdealMore.data.title }} →</a></span>
              </div>
              {% endif %}
              {% endif %}
            </div>
          </details>
        </div>
        {% endif %}

        {% if amazonFlagship %}
        <div class="milestone milestone--amazon">
          {{ companyLogo.logo({ name: "Amazon", color: "#FF9900", logo: "/assets/images/uploads/logos/amazon.svg" }) }}
          <span class="milestone__company">Amazon{% if amazonFlagship.data.year_or_period %} · {{ amazonFlagship.data.year_or_period }}{% endif %}</span>
          <span class="milestone__title">Operating at global scale, redesigning work with technology</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand Amazon</span></summary>
            <div class="milestone__panel">
              <p>{{ amazonFlagship.data.summary }}</p>
              <div class="diagram-flow">
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.08);">Human review</span>
                <span class="diagram-flow__arrow">→</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.08);">ML</span>
                <span class="diagram-flow__arrow">→</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.08);">Exception handling</span>
                <span class="diagram-flow__arrow">→</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.08);">Human judgement</span>
              </div>
              {% set amazonImpact = amazonFlagship.data.impact | publicImpact %}
              {% if amazonImpact.length %}
              <div class="metric-block" style="margin-bottom: 0.75rem;">
                <span class="metric-block__value" style="--metric-accent: var(--slate); font-size: 1.5rem;">{{ amazonImpact[0].value }}</span>
                <span class="metric-block__label">{{ amazonImpact[0].label }}</span>
              </div>
              {% endif %}
              <a href="{{ amazonFlagship.url }}">Explore the transformation →</a>
              <p style="margin-top: 1rem; font-size: 0.85rem;">Related: <a href="/experience/amazon-catalogue-compliance/">Catalogue Compliance</a>, <a href="/experience/amazon-five-marketplace-launch/">Marketplace Launch</a>, <a href="/experience/amazon-governance-scale/">Governance at Scale</a></p>
            </div>
          </details>
        </div>
        {% endif %}

        {% if addverbFlagship %}
        <div class="milestone milestone--addverb">
          {{ companyLogo.logo({ name: "Addverb", color: "#35513F", logo: "/assets/images/uploads/logos/addverb.png" }) }}
          <span class="milestone__company">Addverb{% if addverbCeoOffice.data.year_or_period %} · {{ addverbCeoOffice.data.year_or_period }}{% endif %}</span>
          <span class="milestone__title">Working beside leadership on enterprise transformation</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand Addverb</span></summary>
            <div class="milestone__panel">
              <p>{{ addverbFlagship.data.summary }}</p>
              <div class="diagram-flow">
                <span class="diagram-flow__node" style="--diagram-accent: var(--terracotta);">Fragmented functions</span>
                <span class="diagram-flow__arrow">→</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--accent); --diagram-tint: rgba(53,81,63,0.08);">Connected operating backbone</span>
              </div>
              {% set addverbImpact = addverbFlagship.data.impact | publicImpact %}
              {% if addverbImpact.length %}
              <div class="metric-block" style="margin-bottom: 0.75rem;">
                <span class="metric-block__value" style="font-size: 1.5rem;">{{ addverbImpact[0].value }}</span>
                <span class="metric-block__label">{{ addverbImpact[0].label }}</span>
              </div>
              {% endif %}
              <a href="{{ addverbFlagship.url }}">Explore the transformation →</a>
              <p style="margin-top: 1rem; font-size: 0.85rem;">Related: {% if addverbCeoOffice %}<a href="{{ addverbCeoOffice.url }}">{{ addverbCeoOffice.data.title }}</a>{% endif %}{% if addverbSupply %}, <a href="{{ addverbSupply.url }}">{{ addverbSupply.data.title }}</a>{% endif %}</p>
            </div>
          </details>
        </div>
        {% endif %}

        <div class="milestone milestone--paytm">
          {{ companyLogo.logo({ name: "Paytm", color: "#00BAF2", logo: "/assets/images/uploads/logos/paytm.svg" }) }}
          <span class="milestone__company">Paytm</span>
          <span class="milestone__title">Operating inside a large-scale digital ecosystem</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand Paytm</span></summary>
            <div class="milestone__panel">
              <p>Commercial and operating work across Paytm's retail offline business, spanning acquisitions and commercial execution inside one of India's largest digital platforms.</p>
            </div>
          </details>
        </div>

        {% if clearmeatBusiness %}
        <div class="milestone milestone--clearmeat">
          {{ companyLogo.logo({ name: "ClearMeat", color: "#7C8F6E", logo: "/assets/images/uploads/logos/clearmeat.png" }) }}
          <span class="milestone__company">ClearMeat</span>
          <span class="milestone__title">I chose to step into the unknown.</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand ClearMeat</span></summary>
            <div class="milestone__panel">
              <p>Stepping deliberately into an emerging industry: emerging technology, business-model adaptation, commercialisation, capital discipline, government and regulation, ecosystem-building, with fewer established structures to lean on than at any previous stage.</p>
              <div class="diagram-flow">
                <span class="diagram-flow__node" style="--diagram-accent: var(--sage); --diagram-tint: rgba(124,143,110,0.08);">B2C</span>
                <span class="diagram-flow__arrow">→</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--sage); --diagram-tint: rgba(124,143,110,0.08);">B2B / B2G</span>
              </div>
              {% set clearmeatImpact = clearmeatBusiness.data.impact | publicImpact %}
              {% if clearmeatImpact.length %}
              <div class="metric-block" style="margin-bottom: 0.75rem;">
                <span class="metric-block__value" style="--metric-accent: var(--sage); font-size: 1.5rem;">{{ clearmeatImpact[0].value }}</span>
                <span class="metric-block__label">{{ clearmeatImpact[0].label }}</span>
              </div>
              {% endif %}
              <a href="{{ clearmeatBusiness.url }}">Explore the transformation →</a>
              {% if clearmeatRegulatory %}
              <p style="margin-top: 1.25rem; font-size: 0.92rem;">The regulatory and ecosystem side of the same industry required a different kind of map:</p>
              <div class="diagram-flow">
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.07); font-size: 0.72rem;">Company</span>
                <span class="diagram-flow__arrow">↔</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.07); font-size: 0.72rem;">Regulator</span>
                <span class="diagram-flow__arrow">↔</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.07); font-size: 0.72rem;">Industry</span>
                <span class="diagram-flow__arrow">↔</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.07); font-size: 0.72rem;">Research</span>
                <span class="diagram-flow__arrow">↔</span>
                <span class="diagram-flow__node" style="--diagram-accent: var(--slate); --diagram-tint: rgba(91,112,136,0.07); font-size: 0.72rem;">Market</span>
              </div>
              <a href="{{ clearmeatRegulatory.url }}">Explore the regulatory ecosystem story →</a>
              {% endif %}
              <p style="margin-top: 1rem; font-size: 0.85rem;">Related: {% if clearmeatSales %}<a href="{{ clearmeatSales.url }}">{{ clearmeatSales.data.title }}</a>{% endif %}{% if clearmeatVendor %}, <a href="{{ clearmeatVendor.url }}">{{ clearmeatVendor.data.title }}</a>{% endif %}</p>
            </div>
          </details>
        </div>
        {% endif %}

        {% if systemFlagship %}
        <div class="milestone milestone--system">
          {{ companyLogo.logo({ name: "ABWCI", color: "#5B7088", logo: "/assets/images/uploads/logos/abwci.png" }) }}
          <span class="milestone__company">System &amp; Ecosystem Work</span>
          <span class="milestone__title">Applying operating experience to institutional and policy problems</span>
          <details>
            <summary class="milestone-toggle"><span class="milestone__plus" aria-hidden="true"><span class="milestone__plus-glyph">+</span><span class="milestone__minus-glyph">−</span></span> <span class="sr-only">Expand System and Ecosystem Work</span></summary>
            <div class="milestone__panel">
              <p>{{ systemFlagship.data.card_summary or systemFlagship.data.summary }}</p>
              <a href="{{ systemFlagship.url }}">Explore the transformation →</a>
              <p style="margin-top: 1rem; font-size: 0.85rem;">Related: {% if systemMarket %}<a href="{{ systemMarket.url }}">{{ systemMarket.data.title }}</a>{% endif %}{% if systemUnctad %}, <a href="{{ systemUnctad.url }}">{{ systemUnctad.data.title }}</a>{% endif %}</p>
            </div>
          </details>
        </div>
        {% endif %}

      </div>
    </div>
  </div>
</section>

<section class="tier-dominant teaser">
  <div class="wrap">
    <div class="section-heading" style="margin-left: auto; margin-right: auto; text-align: center;">
      <span class="section-label" style="text-align: center; display: block;">What I Carry Forward</span>
      <h2>Threads that connect every chapter</h2>
    </div>
    <div class="capability-blocks">
      <div class="capability-block capability-block--slate">
        <span class="capability-block__label">Global Scale</span>
        <p class="capability-block__companies">Amazon</p>
      </div>
      <div class="capability-block capability-block--forest">
        <span class="capability-block__label">CEO Office</span>
        <p class="capability-block__companies">Addverb</p>
      </div>
      <div class="capability-block capability-block--slate">
        <span class="capability-block__label">AI &amp; Technology</span>
        <p class="capability-block__companies">Amazon · Addverb</p>
      </div>
      <div class="capability-block capability-block--gold">
        <span class="capability-block__label">Customer &amp; Commercial</span>
        <p class="capability-block__companies">DHL · ICICI · Snapdeal · Paytm</p>
      </div>
      <div class="capability-block capability-block--sage">
        <span class="capability-block__label">0→1 &amp; Business Building</span>
        <p class="capability-block__companies">ClearMeat</p>
      </div>
      <div class="capability-block capability-block--rose">
        <span class="capability-block__label">Policy &amp; Ecosystems</span>
        <p class="capability-block__companies">ClearMeat · ABWCI · UNCTAD</p>
      </div>
    </div>
    <div class="convergence-path" aria-label="Figure Out, Design, Build, Scale, Transform">
      <span>Figure Out</span><span>Design</span><span>Build</span><span>Scale</span><span>Transform</span>
    </div>
    <div class="teaser__ctas" style="justify-content: center; margin-top: 1.5rem;">
      <a class="btn btn--primary" href="/contact/">Start a Conversation →</a>
    </div>
  </div>
</section>

{% if collections.activeBroadFilters.length %}
<section class="capability-filter-section" style="padding-top: clamp(2rem, 4vw, 3rem);">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Explore</span>
      <h2>Every problem, by theme</h2>
    </div>
    <span class="capability-filter__intro-label">Filter by capability</span>
    <div class="capability-filter" data-filter-bar>
      <button type="button" class="is-active" data-filter="all">All</button>
      {% for bf in collections.activeBroadFilters %}
      <button type="button" data-filter="{{ bf.slug }}">{{ bf.label }}</button>
      {% endfor %}
    </div>
    <p class="filter-empty-state" hidden>No stories match this filter yet. <a href="/experience/" data-filter-reset>View all →</a></p>
  </div>
</section>
{% endif %}

{% set flagshipStories = collections.experienceStories | featured %}
{% if flagshipStories.length %}
{% set flagshipTints = { "addverb-enterprise-transformation": "forest", "amazon-ai-ml-transformation": "slate", "clearmeat-business-model": "sage" } %}
<section class="experience-teaser tier-secondary">
  <div class="wrap">
    <div class="flagship-grid">
      {% for story in flagshipStories %}
        {{ cards.storyCard(story, collections.capabilityList, "large" if loop.first else "regular", flagshipTints[story.data.slug or story.fileSlug]) }}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set layer2Stories = collections.experienceStories | notFeatured %}
{% set layer2Initial = layer2Stories | limit(6) %}
{% set layer2Extra = layer2Stories | sliceArr(6, layer2Stories.length) %}
{% set cardTints = ["terracotta", "gold", "slate", "sage", "forest", "rose"] %}
{% if layer2Stories.length %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="card-grid">
      {% for story in layer2Initial %}
        {{ cards.storyCard(story, collections.capabilityList, null, cardTints[loop.index0 % 6]) }}
      {% endfor %}
    </div>

    {% if layer2Extra.length %}
    <details class="disclosure" id="more-stories-disclosure">
      <summary class="disclosure__summary">
        <span class="disclosure__label-more">View more problems I've worked on ↓</span>
        <span class="disclosure__label-fewer">Show fewer ↑</span>
      </summary>
      <div class="card-grid" style="margin-top: 1.75rem;">
        {% for story in layer2Extra %}
          {{ cards.storyCard(story, collections.capabilityList, null, cardTints[(loop.index0 + 6) % 6]) }}
        {% endfor %}
      </div>
    </details>
    {% endif %}
  </div>
</section>
{% endif %}

{% set recsInitial = collections.recommendations | limit(4) %}
{% set recsExtra = collections.recommendations | sliceArr(4, collections.recommendations.length) %}
{% if collections.recommendations.length %}
<section class="teaser tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Recommendations</span>
      <h2>What people I've worked with say</h2>
    </div>
    <div class="recommendation-grid">
      {% for rec in recsInitial %}
        {{ recs.quote(rec) }}
      {% endfor %}
    </div>

    {% if recsExtra.length %}
    <details class="disclosure">
      <summary class="disclosure__summary">
        <span class="disclosure__label-more">Read more from people I've worked with ↓</span>
        <span class="disclosure__label-fewer">Show fewer ↑</span>
      </summary>
      <div class="recommendation-grid" style="margin-top: 1.75rem;">
        {% for rec in recsExtra %}
          {{ recs.quote(rec) }}
        {% endfor %}
      </div>
    </details>
    {% endif %}
  </div>
</section>
{% endif %}

<section class="tier-supporting">
  <div class="wrap">
    {% include "partials/linkedin-cta.njk" %}
  </div>
</section>
