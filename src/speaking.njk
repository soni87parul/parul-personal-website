---
title: Speaking
layout: layouts/base.njk
seoTitle: Speaking | Parul Soni Manvati
seoDescription: Parul speaks on strategy, transformation, technology, scaling, emerging businesses, leadership and building organisations for what comes next.
---
{% import "partials/media-placeholder.njk" as media %}

<section class="page-header">
  <div class="wrap">
    <h1>Conversations worth having.</h1>
    <p>Parul speaks on strategy, transformation, technology, scaling, emerging businesses, leadership and building organisations for what comes next.</p>
  </div>
</section>

{% set safeTopics = speakingTopics.items | publiclySafe %}
{% if safeTopics.length %}
<section>
  <div class="wrap split">
    <div>
      <div class="section-heading" style="margin-bottom: 1rem;">
        <span class="section-label">What I speak about</span>
        <h2>Ideas worth putting in a room together.</h2>
      </div>
      <div class="about-chapters">
        {% for topic in safeTopics | limit(4) %}
        <div class="about-chapters__item">
          <span class="about-chapters__number">{{ "0" + (loop.index | string) if loop.index < 10 else loop.index }}</span>
          <div>
            <span class="about-chapters__label">{{ topic.title }}</span>
            <p class="about-chapters__desc">{{ topic.description }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div>
      {{ media.placeholder("Parul speaking on stage", "16/9") }}
    </div>
  </div>
</section>
{% endif %}

<section class="teaser tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Archive</span>
      <h2>Selected Speaking &amp; Appearances</h2>
    </div>
    {% set publishedEvents = speakingEvents.items | selectattr("published") | publiclySafe %}
    {% if publishedEvents.length %}
    <div class="appearance-list">
      {% for event in publishedEvents %}
      <div class="appearance-card">
        <span class="appearance-card__year">{{ event.year or "TBD" }}</span>
        <div>
          <h3 class="appearance-card__title">{{ event.title }}{% if event.organisation %} · {{ event.organisation }}{% endif %}</h3>
          {% if event.topic %}<p class="appearance-card__meta">{{ event.topic }}</p>{% endif %}
          {% if event.location %}<p class="appearance-card__meta">{{ event.location }}</p>{% endif %}
          {% if event.videoUrl %}
          <a class="appearance-card__link" href="{{ event.videoUrl }}" target="_blank" rel="noopener noreferrer">Watch talk →</a>
          {% elif event.externalUrl %}
          <a class="appearance-card__link" href="{{ event.externalUrl }}" target="_blank" rel="noopener noreferrer">Learn more →</a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">Selected speaking appearances will appear here as they're confirmed.</div>
    {% endif %}

    <div class="teaser__ctas" style="margin-top: 3rem;">
      <a class="btn btn--primary" href="/contact/">Invite Parul to speak →</a>
    </div>
  </div>
</section>
