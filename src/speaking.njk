---
title: Speaking
layout: layouts/base.njk
seoKey: speaking
---
{% import "partials/media-placeholder.njk" as media %}
{% import "partials/photo.njk" as ph %}

<section class="hero page-header--tight speaking-hero">
  <div class="wrap hero__grid hero__grid--speaking">
    <div>
      <span class="eyebrow">SPEAKING</span>
      <h1 class="hero__headline">Conversations worth having.</h1>
      <p class="hero__subtext">From the future of food and alternative proteins to supply chains, AI and emerging industries, I speak about how businesses, technologies and systems evolve.</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/contact/?intent=speaking">Invite Parul to Speak →</a>
        <a class="btn btn--secondary" href="/contact/">Start a Conversation →</a>
      </div>
    </div>
    <div>
      <div class="hero__image-wrap speaking-hero__media">
        {% if speakingPage.heroImage %}
        <img src="{{ speakingPage.heroImage }}" alt="{{ speakingPage.heroImageAlt or '' }}" loading="eager" fetchpriority="high" decoding="async">
        {% else %}
        {{ ph.photo(photos["gulfood-foodpulse"], { fill: true, eager: true, sizes: "(max-width: 860px) 94vw, 560px" }) }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% set safeTopics = speakingTopics.items | publiclySafe %}
{% if safeTopics.length %}
<section class="tier-dominant">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Topics</span>
      <h2>What I speak about</h2>
      {% if speakingPage.topicsIntro %}<p>{{ speakingPage.topicsIntro }}</p>{% endif %}
    </div>
    <div class="topics-split">
      <div class="topics-split__photo">
        {{ ph.photo(photos["superwomen-speaking"], { sizes: "(max-width: 860px) 320px, 360px" }) }}
      </div>
      {% set topicIcons = ["◐", "⚙", "▲", "✦", "◎", "⌕"] %}
      <div class="territory-grid">
        {% for topic in safeTopics %}
        <a class="territory-card" href="/contact/?intent=speaking&topic={{ topic.title | lower | replace(' ', '-') }}" style="--territory-accent: var(--{{ topic.accent }});">
          <span class="territory-card__icon" aria-hidden="true">{{ topicIcons[loop.index0] }}</span>
          <span class="territory-card__title">{{ topic.title }}{% if topic.hasImage %} <span style="font-size: 0.65rem; color: var(--muted); font-weight: 400;">(photo)</span>{% endif %}</span>
          <span class="territory-card__desc">{{ topic.keywords }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if speakingMoments.items.length %}
<section class="tier-secondary moments-section">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Featured</span>
      <h2>Featured Speaking</h2>
    </div>
    {% for row in speakingMoments.items | batch(4) %}
    <div class="moment-strip" data-expand-row>
      {% for moment in row %}
      {% set momentPhoto = photos[moment.photo] %}
      {% if momentPhoto %}
      <figure class="moment" data-expand-item tabindex="0">
        {{ ph.photo(momentPhoto, { fill: true, sizes: "(max-width: 860px) 80vw, 420px" }) }}
        <figcaption class="moment__overlay">
          <span class="moment__label">{{ moment.label }}</span>
          <span class="moment__more">
            <span class="moment__caption">{{ moment.caption }}</span>
            <span class="moment__context">{{ moment.context }}</span>
          </span>
        </figcaption>
      </figure>
      {% endif %}
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% set featuredEvent = speakingEvents.items | selectattr("published") | selectattr("featured") | publiclySafe | first %}
{% if featuredEvent %}
<section class="tier-secondary teaser">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Featured</span>
      <h2>Featured Speaking Appearance</h2>
    </div>
    {% if featuredEvent %}
    <div class="split" style="align-items: center;">
      <div>{% if featuredEvent.image %}<img class="featured-event__image" src="{{ featuredEvent.image }}" alt="{{ featuredEvent.title }}" loading="lazy" decoding="async">{% else %}{{ media.placeholder(featuredEvent.title, "16/9") }}{% endif %}</div>
      <div>
        <h3>{{ featuredEvent.title }}</h3>
        {% if featuredEvent.topic %}<p style="color: var(--muted);">{{ featuredEvent.topic }}</p>{% endif %}
        {% if featuredEvent.externalUrl %}<a class="btn btn--text" href="{{ featuredEvent.externalUrl }}" target="_blank" rel="noopener noreferrer">View appearance →</a>{% endif %}
      </div>
    </div>
    {% else %}
    <div class="empty-state">A featured speaking appearance will appear here once one is confirmed and published.</div>
    {% endif %}
  </div>
</section>
{% endif %}

{% set publishedEvents = speakingEvents.items | selectattr("published") | publiclySafe %}
{% if publishedEvents.length %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Archive</span>
      <h2>Selected Speaking &amp; Appearances</h2>
      <p>Grounded in the industries, organisations and systems I've worked inside, not commentary from the sidelines.</p>
    </div>
    <div class="expand-appearance-row" data-expand-row>
      {% for event in publishedEvents %}
      <div class="expand-appearance" data-expand-item tabindex="0">
        <div class="expand-appearance__media">{% if event.image %}<img src="{{ event.image }}" alt="{{ event.title }}" loading="lazy" decoding="async">{% else %}{{ media.placeholder(event.title, "3/4") }}{% endif %}</div>
        <div class="expand-appearance__overlay">
          <span class="expand-appearance__year">{{ event.year or "TBD" }}</span>
          <span class="expand-appearance__title">{{ event.title }}{% if event.organisation %} · {{ event.organisation }}{% endif %}</span>
          <p class="expand-appearance__meta">
            {%- if event.topic %}{{ event.topic }}{% endif -%}
            {%- if event.videoUrl %} · <a href="{{ event.videoUrl }}" target="_blank" rel="noopener noreferrer" style="color: inherit;">Watch talk →</a>
            {%- elif event.externalUrl %} · <a href="{{ event.externalUrl }}" target="_blank" rel="noopener noreferrer" style="color: inherit;">Learn more →</a>{% endif -%}
          </p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="tier-dominant section--dark">
  <div class="wrap circular-media-section" data-circular-media>
    <span class="section-label" style="display: block;">Speaking</span>
    <div class="circular-media">
      <div class="circular-media__disc">
        {% if speakingPage.circularVideo %}
        <video class="circular-media__video" src="{{ speakingPage.circularVideo }}"{% if speakingPage.circularPoster %} poster="{{ speakingPage.circularPoster }}"{% endif %} muted autoplay loop playsinline preload="metadata" aria-label="Short clip of Parul speaking"></video>
        {% elif speakingPage.circularYouTubeId %}
        <div class="circular-media__yt" data-yt-clip data-yt-id="{{ speakingPage.circularYouTubeId }}" data-yt-start="{{ speakingPage.circularYouTubeStart }}" data-yt-end="{{ speakingPage.circularYouTubeEnd }}" data-yt-speed="{{ speakingPage.circularYouTubeSpeed }}">
          <iframe src="https://www.youtube-nocookie.com/embed/{{ speakingPage.circularYouTubeId }}?start={{ speakingPage.circularYouTubeStart }}&end={{ speakingPage.circularYouTubeEnd }}&autoplay=1&mute=1&controls=0&playsinline=1&modestbranding=1&rel=0&iv_load_policy=3&cc_load_policy=0&disablekb=1&fs=0&enablejsapi=1" title="Short clip of Parul speaking" allow="autoplay; encrypted-media" tabindex="-1"></iframe>
        </div>
        {% elif speakingPage.circularPoster %}
        <img src="{{ speakingPage.circularPoster }}" alt="Parul speaking" loading="lazy" decoding="async">
        {% else %}
        {{ media.placeholder("Speaking clip", "1/1", "Development placeholder. An approved video replaces this.") }}
        {% endif %}
      </div>
      <div class="circular-media__topics">
        {% for topic in safeTopics %}
        {% set angle = loop.index0 * (360 / safeTopics.length) %}
        <button type="button" class="circular-media__topic" data-caption="{{ topic.description | truncate(80) }}" style="left: 50%; top: 50%; transform: rotate({{ angle }}deg) translate(0, -250px) rotate(-{{ angle }}deg);"><span>{{ topic.title }}</span></button>
        {% endfor %}
      </div>
    </div>
    <p class="circular-media__caption" data-circular-caption></p>
  </div>
</section>

<section class="tier-dominant section--dark" style="padding-top: 0;">
  <div class="wrap" style="text-align: center;">
    <h2 style="max-width: 24ch; margin: 0 auto 1.5rem;">Bring an operator's perspective to the room.</h2>
    <div class="teaser__ctas" style="justify-content: center;">
      <a class="btn btn--primary" href="/contact/?intent=speaking">Invite Parul to Speak →</a>
      <a class="btn btn--secondary" href="/contact/">Start a Conversation →</a>
    </div>
  </div>
</section>
