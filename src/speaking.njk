---
title: Speaking
layout: layouts/base.njk
seoTitle: Speaking | Parul Soni Manvati
seoDescription: "From the future of food and alternative proteins to supply chains, AI and emerging industries, Parul speaks about how businesses, technologies and systems evolve."
---
{% import "partials/media-placeholder.njk" as media %}

<section class="hero page-header--tight">
  <div class="wrap hero__grid">
    <div>
      <span class="eyebrow">SPEAKING</span>
      <h1 class="hero__headline">Conversations worth having.</h1>
      <p class="hero__subtext">From the future of food and alternative proteins to supply chains, AI and emerging industries, I speak about how businesses, technologies and systems evolve.</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/contact/?intent=speaking">Invite Parul to Speak →</a>
        <a class="btn btn--secondary" href="/contact/">Start a Conversation →</a>
      </div>
    </div>
    <div>
      <div class="hero__image-wrap" style="aspect-ratio: 16/10;">
        {{ media.placeholder("Parul speaking on stage", "16/10", "No real speaking photograph is in the project yet.") }}
      </div>
    </div>
  </div>
</section>

{% set safeTopics = speakingTopics.items | publiclySafe %}
{% if safeTopics.length %}
<section class="tier-dominant">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Topics</span>
      <h2>What I speak about</h2>
    </div>
    <div class="topic-mosaic">
      {% for topic in safeTopics %}
      {% set sizeClass = "topic-tile--large" if loop.index0 == 0 else ("topic-tile--wide" if loop.index0 == 5 else "topic-tile--small") %}
      <a class="topic-tile {{ sizeClass }} topic-tile--{{ topic.accent }}{% if topic.hasImage %} topic-tile--image{% endif %}" href="/contact/?intent=speaking&topic={{ topic.title | lower | replace(' ', '-') }}">
        {% if topic.hasImage %}<span class="topic-tile__icon" aria-hidden="true">◈</span>{% endif %}
        <div>
          <span class="topic-tile__eyebrow">{% if topic.hasImage %}Image placeholder{% else %}Topic{% endif %}</span>
          <span class="topic-tile__title">{{ topic.title }}</span>
          <span class="topic-tile__keywords">{{ topic.keywords }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set featuredEvent = speakingEvents.items | selectattr("published") | selectattr("featured") | publiclySafe | first %}
<section class="tier-secondary teaser">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Featured</span>
      <h2>Featured Speaking Appearance</h2>
    </div>
    {% if featuredEvent %}
    <div class="split" style="align-items: center;">
      <div>{{ media.placeholder(featuredEvent.title, "16/9") }}</div>
      <div>
        <h3>{{ featuredEvent.title }}</h3>
        {% if featuredEvent.topic %}<p style="color: var(--muted);">{{ featuredEvent.topic }}</p>{% endif %}
        {% if featuredEvent.externalUrl %}<a class="btn btn--text" href="{{ featuredEvent.externalUrl }}" target="_blank" rel="noopener noreferrer">View appearance →</a>{% endif %}
      </div>
    </div>
    {% else %}
    <div class="empty-state">A featured speaking appearance will appear here once one is confirmed and published.</div>
    {% endif %}
  </div>
</section>

<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Archive</span>
      <h2>Selected Speaking &amp; Appearances</h2>
      <p>Grounded in the industries, organisations and systems I've worked inside, not commentary from the sidelines.</p>
    </div>
    {% set publishedEvents = speakingEvents.items | selectattr("published") | publiclySafe %}
    {% if publishedEvents.length %}
    <div class="appearance-list">
      {% for event in publishedEvents %}
      <div class="appearance-card">
        <span class="appearance-card__year">{{ event.year or "TBD" }}</span>
        <div>
          <h3 class="appearance-card__title">{{ event.title }}{% if event.organisation %} · {{ event.organisation }}{% endif %}</h3>
          {% if event.topic %}<p class="appearance-card__meta">{{ event.topic }}</p>{% endif %}
          {% if event.location %}<p class="appearance-card__meta">{{ event.location }}</p>{% endif %}
          {% if event.videoUrl %}
          <a class="appearance-card__link" href="{{ event.videoUrl }}" target="_blank" rel="noopener noreferrer">Watch talk →</a>
          {% elif event.externalUrl %}
          <a class="appearance-card__link" href="{{ event.externalUrl }}" target="_blank" rel="noopener noreferrer">Learn more →</a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">Selected speaking appearances will appear here as they're confirmed.</div>
    {% endif %}
  </div>
</section>

<section class="tier-dominant section--dark">
  <div class="wrap" style="text-align: center;">
    <span class="section-label" style="display: block;">Speaking</span>
    <h2 style="max-width: 24ch; margin: 0 auto 1.5rem;">Bring an operator's perspective to the room.</h2>
    <div class="teaser__ctas" style="justify-content: center;">
      <a class="btn btn--primary" href="/contact/?intent=speaking">Invite Parul to Speak →</a>
      <a class="btn btn--secondary" href="/contact/">Start a Conversation →</a>
    </div>
  </div>
</section>
