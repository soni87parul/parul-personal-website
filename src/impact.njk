---
title: Impact
layout: layouts/base.njk
seoTitle: Impact | Parul Soni Manvati
seoDescription: Building institutions and communities, not only businesses, including work with ABWCI / Women in Supply Chain.
---
<section class="page-header">
  <div class="wrap">
    <h1>Beyond business</h1>
    <p>Building institutions and communities, not only businesses.</p>
  </div>
</section>

<section>
  <div class="wrap">
    {% set publishedProjects = impactProjects.items | selectattr("published") | publiclySafe %}
    {% if publishedProjects.length %}
    <div class="card-grid">
      {% for project in publishedProjects %}
      {% if project.link %}
      <a class="story-card" href="{{ project.link }}" target="_blank" rel="noopener noreferrer">
        <h3>{{ project.title }}</h3>
        <p class="card-body">{{ project.description }}</p>
        <span class="accent-card__link">Learn more →</span>
      </a>
      {% else %}
      <article class="story-card">
        <h3>{{ project.title }}</h3>
        <p class="card-body">{{ project.description }}</p>
      </article>
      {% endif %}
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-state">No impact projects published yet. Add one via Admin → Impact.</div>
    {% endif %}
  </div>
</section>
