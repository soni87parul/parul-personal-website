---
title: Parul Soni Manvati | Transformation Leader & Strategic Operator
layout: layouts/base.njk
---
{% import "partials/media-placeholder.njk" as media %}
{% import "partials/cta.njk" as cta %}

<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <span class="hero__label">{{ homepage.heroPositioningLabel }}</span>
      <h1 class="hero__headline">{{ homepage.heroHeadline }}</h1>
      <p class="hero__subtext">{{ homepage.heroSubtext }}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="{{ homepage.heroPrimaryCtaLink }}">{{ homepage.heroPrimaryCtaLabel }}</a>
        <a class="btn btn--secondary" href="{{ homepage.heroSecondaryCtaLink }}">{{ homepage.heroSecondaryCtaLabel }}</a>
      </div>
    </div>
    <div>
      <div class="hero__image-wrap">
        {{ media.placeholder("Executive portrait", "4/5", "Confident, approachable, credible for a CEO/board/investor audience.") }}
      </div>
      {% if homepage.heroSupportingGlimpses.length %}
      <div class="hero__glimpses">
        {% for glimpse in homepage.heroSupportingGlimpses %}
        <div class="hero__glimpse">
          {{ media.placeholder(glimpse.label, glimpse.ratio) }}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="credibility">
  <div class="wrap">
    <p class="credibility__heading">{{ homepage.credibilityHeading }}</p>
    <div class="company-strip">
      {% for logo in homepage.credibilityLogos %}
      <span class="company-strip__mark" style="--mark-color: {{ logo.color }};">{{ logo.name }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<section class="statement-dark">
  <div class="wrap">
    <span class="statement-dark__mark" aria-hidden="true">“</span>
    <blockquote>{{ homepage.signatureStatement }}</blockquote>
  </div>
</section>

<section class="method tier-secondary" id="method">
  <div class="wrap">
    <div class="section-heading" style="text-align: center; margin-left: auto; margin-right: auto;">
      <span class="section-label">Method</span>
      <h2>{{ homepage.methodHeading }}</h2>
      <p style="margin-left: auto; margin-right: auto;">{{ homepage.methodSubheading }}</p>
    </div>
    {% include "partials/methodology-loop.njk" %}
  </div>
</section>

<section class="experience-teaser tier-dominant">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Evidence</span>
      <h2>{{ homepage.experienceHeading }}</h2>
      <p>{{ homepage.experienceSubheading }}</p>
    </div>

    {% set addverb = "addverb-enterprise-transformation" | experienceByRef(collections.experienceStories) %}
    {% set amazon = "amazon-ai-ml-transformation" | experienceByRef(collections.experienceStories) %}
    {% set clearmeat = "clearmeat-business-model" | experienceByRef(collections.experienceStories) %}

    <div class="evidence-grid">
      {% if addverb %}
      <a class="evidence-card evidence-card--dominant evidence-card--forest" href="{{ addverb.url }}">
        <div class="evidence-card__visual">
          <div class="diagram-flow" style="justify-content: center; padding: 1.5rem;">
            <span class="diagram-flow__node" style="--diagram-accent: var(--terracotta);">Fragmented functions</span>
            <span class="diagram-flow__arrow">→</span>
            <span class="diagram-flow__node" style="--diagram-accent: var(--accent); --diagram-tint: rgba(53,81,63,0.08);">Connected operating backbone</span>
          </div>
        </div>
        <div class="evidence-card__content">
          <span class="evidence-card__meta">{{ addverb.data.organisation }}{% if addverb.data.year_or_period %} · {{ addverb.data.year_or_period }}{% endif %}</span>
          <h3>{{ addverb.data.title }}</h3>
          <p>{{ addverb.data.summary }}</p>
          {% set addverbImpact = addverb.data.impact | publicImpact %}
          {% if addverbImpact.length %}
          <div class="metric-block" style="margin-bottom: 1rem;">
            <span class="metric-block__value" style="--metric-accent: var(--accent); font-size: 1.9rem;">{{ addverbImpact[0].value }}</span>
            <span class="metric-block__label">{{ addverbImpact[0].label }}</span>
          </div>
          {% endif %}
          <span class="accent-card__link">Explore the transformation →</span>
        </div>
      </a>
      {% endif %}

      {% if amazon %}
      <a class="evidence-card evidence-card--compact evidence-card--slate" href="{{ amazon.url }}">
        <span class="evidence-card__meta">{{ amazon.data.organisation }}{% if amazon.data.year_or_period %} · {{ amazon.data.year_or_period }}{% endif %}</span>
        <h3>{{ amazon.data.title }}</h3>
        {% set amazonImpact = amazon.data.impact | publicImpact %}
        {% if amazonImpact.length %}
        <div class="metric-block" style="margin-bottom: 1rem;">
          <span class="metric-block__value" style="--metric-accent: var(--slate); font-size: 1.9rem;">{{ amazonImpact[0].value }}</span>
          <span class="metric-block__label">{{ amazonImpact[0].label }}</span>
        </div>
        {% endif %}
        <p>Using AI to create capacity without simply adding people.</p>
        <span class="accent-card__link">Explore the transformation →</span>
      </a>
      {% endif %}

      {% if clearmeat %}
      <a class="evidence-card evidence-card--compact evidence-card--sage" href="{{ clearmeat.url }}">
        <span class="evidence-card__meta">{{ clearmeat.data.organisation }}</span>
        <h3>B2C → B2B / B2G</h3>
        {% set clearmeatImpact = clearmeat.data.impact | publicImpact %}
        {% if clearmeatImpact.length %}
        <div class="metric-block" style="margin-bottom: 1rem;">
          <span class="metric-block__value" style="--metric-accent: var(--sage); font-size: 1.9rem;">{{ clearmeatImpact[0].value }}</span>
          <span class="metric-block__label">{{ clearmeatImpact[0].label }}</span>
        </div>
        {% endif %}
        <p>Reframing a cultivated-meat startup toward an ingredient-led model.</p>
        <span class="accent-card__link">Explore the transformation →</span>
      </a>
      {% endif %}
    </div>

    <div class="section-footer">
      <a class="btn btn--text" href="/experience/">{{ homepage.experienceViewAllLabel }}</a>
    </div>
  </div>
</section>

{% set featuredIdea = collections.articles | featured | limit(1) %}
{% set moreIdeas = collections.articles | notFeatured | limit(3) %}
{% if featuredIdea.length or moreIdeas.length %}
<section class="thinking-teaser tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Ideas</span>
      <h2>{{ homepage.thinkingHeading }}</h2>
      <p>{{ homepage.thinkingSubheading }}</p>
    </div>

    <div class="ideas-grid">
      {% if featuredIdea.length %}
      {% set idea = featuredIdea[0] %}
      {% set ideaTerritory = idea.data.territory | territoryData %}
      <a class="accent-card ideas-grid__featured{% if ideaTerritory %} accent-card--{{ ideaTerritory.accent }}{% endif %}" href="{{ idea.url }}">
        {% if ideaTerritory %}<span class="accent-card__label">{{ ideaTerritory.title }}</span>{% endif %}
        <h3>{{ idea.data.title }}</h3>
        <p>{{ idea.data.excerpt }}</p>
        <span class="accent-card__link">Read the article →</span>
      </a>
      {% endif %}

      <div class="ideas-grid__side">
        <div class="mini-strip mini-strip--compact">
          <span>Work</span><span>Observe</span><span>Figure Out</span><span>Codify</span><span>Share</span><span>Converse</span>
        </div>
        <p class="ideas-grid__caption">How my thinking evolves: <a href="/thinking/#method">see the full loop →</a></p>

        {% if moreIdeas.length %}
        <ul class="ideas-grid__links">
          {% for idea in moreIdeas %}
          <li><a href="{{ idea.url }}">{{ idea.data.title }} →</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </div>

    <div class="section-footer">
      <a class="btn btn--text" href="/thinking/">{{ homepage.thinkingCtaLabel }}</a>
      {% if site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}
      <a class="btn btn--text" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" style="margin-left: 1.5rem;">Continue the conversation on LinkedIn →</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="speaking-teaser tier-dominant section--dark">
  <div class="wrap split">
    <div>
      {{ media.placeholder("Parul speaking on stage", "16/9", null, true) }}
    </div>
    <div>
      <span class="section-label">Voice</span>
      <h2>{{ homepage.speakingHeading }}</h2>
      <p>{{ homepage.speakingText }}</p>
      {% if speakingTopics.items.length %}
      <ul class="pill-list" style="margin-top: 1.5rem;">
        {% for topic in speakingTopics.items | limit(4) %}
        <li class="pill" style="background: transparent; border-color: rgba(255,255,255,0.3); color: var(--background);">{{ topic.title }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="teaser__ctas">
        <a class="btn btn--secondary" href="/speaking/">{{ homepage.speakingCtaLabel }}</a>
      </div>
    </div>
  </div>
</section>

<section class="final-cta tier-dominant">
  <div class="wrap">
    <h2>{{ homepage.finalCtaHeading }}</h2>
    <p>{{ homepage.finalCtaText }}</p>
    <div class="final-cta__ctas">
      <a class="btn btn--primary" href="/contact/">{{ homepage.finalCtaPrimaryLabel }} →</a>
      {% if site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}
      <a class="btn btn--secondary" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">{{ homepage.finalCtaSecondaryLabel }}</a>
      {% endif %}
    </div>
    {% if homepage.opportunityLine %}
    <p class="final-cta__opportunity-line">{{ homepage.opportunityLine }}</p>
    {% endif %}
  </div>
</section>
