---
title: Parul Soni Manvati | Transformation Leader & Strategic Operator
layout: layouts/base.njk
seoKey: home
---
{% import "partials/media-placeholder.njk" as media %}
{% import "partials/cta.njk" as cta %}
{% import "partials/company-logo.njk" as companyLogo %}
{% import "partials/photo.njk" as ph %}

<section class="hero hero--asymmetric">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <span class="hero__label">{{ homepage.heroPositioningLabel }}</span>
      <h1 class="hero__headline">{{ homepage.heroHeadline }}</h1>
      <p class="hero__subtext">{{ homepage.heroSubtext }}</p>
      {% if homepage.heroSupportingParagraph %}<p class="hero__supporting">{{ homepage.heroSupportingParagraph }}</p>{% endif %}
      <div class="hero__ctas">
        <a class="btn btn--primary" href="{{ homepage.heroPrimaryCtaLink }}">{{ homepage.heroPrimaryCtaLabel }} →</a>
        <a class="btn btn--secondary" href="{{ homepage.heroSecondaryCtaLink }}">{{ homepage.heroSecondaryCtaLabel }} →</a>
      </div>
    </div>
    <div class="hero__media">
      <div class="hero__image-wrap hero__image-wrap--framed">
        {% if homepage.heroImage %}
        <img src="{{ homepage.heroImage }}" alt="{{ homepage.heroImageAlt or 'Portrait of Parul Soni Manvati' }}" loading="eager" fetchpriority="high" decoding="async">
        {% else %}
        {{ ph.photo(photos["portrait-golden"], { fill: true, eager: true, sizes: "(max-width: 860px) 100vw, 62vw" }) }}
        {% endif %}
      </div>
      {% if homepage.heroSupportingGlimpses.length %}
      <div class="hero__glimpses">
        {% for glimpse in homepage.heroSupportingGlimpses %}
        <div class="hero__glimpse">
          {{ media.placeholder(glimpse.label, glimpse.ratio) }}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% if homepage.journeyPhotoCards.length %}
<section class="journey-photos tier-secondary">
  <div class="wrap">
    <div class="journey-photos__grid">
      {% for card in homepage.journeyPhotoCards %}
      {% set cardPhoto = photos[card.photo] %}
      <article class="photo-card">
        <div class="photo-card__media">{{ ph.photo(cardPhoto, { sizes: "(max-width: 860px) 94vw, 560px" }) }}</div>
        <div class="photo-card__body">
          <span class="photo-card__label">{{ card.label }}</span>
          <h3>{{ card.title }}</h3>
          <p>{{ card.text }}</p>
          {% if card.link %}<a class="photo-card__link" href="{{ card.link }}">{{ card.linkLabel or "Read the story →" }}</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="identity-strip-section tier-supporting">
  <div class="wrap">
    <div class="identity-strip" data-identity-strip>
      {% for card in homepage.whatIBringCards %}
      <div class="identity-strip__zone" tabindex="0" style="--identity-accent: var(--{{ card.accent }});">
        <span class="identity-strip__title">{{ card.title }}</span>
        <span class="identity-strip__desc">{{ card.description }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="credibility">
  <div class="wrap">
    <p class="credibility__heading">{{ homepage.credibilityHeading }}</p>
    <div class="impact-strip" data-impact-strip>
      <div class="impact-strip__logos">
        {% for c in homepage.credibilityLogos %}
        <button type="button" class="impact-strip__logo-btn" data-name="{{ c.name }}" data-role="{{ c.impactRole }}" data-metric-value="{{ c.impactMetricValue }}" data-metric-label="{{ c.impactMetricLabel }}" data-accent="{{ c.color }}">
          {{ companyLogo.logo(c) }}
        </button>
        {% endfor %}
      </div>
      <div class="impact-strip__panel" data-impact-panel>
        <p class="impact-strip__panel-role"><strong></strong><span></span></p>
        <div class="impact-strip__panel-metric" hidden>
          <span class="impact-strip__panel-metric-value"></span>
          <span class="impact-strip__panel-metric-label"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="statement-dark">
  <div class="wrap">
    <span class="statement-dark__mark" aria-hidden="true">“</span>
    <blockquote>{{ homepage.signatureStatement }}</blockquote>
  </div>
</section>

<section class="method tier-secondary" id="method">
  <div class="wrap">
    <div class="section-heading" style="text-align: center; margin-left: auto; margin-right: auto;">
      <span class="section-label">Method</span>
      <h2>{{ homepage.methodHeading }}</h2>
      <p style="margin-left: auto; margin-right: auto;">{{ homepage.methodSubheading }}</p>
    </div>
    {% include "partials/methodology-line.njk" %}
  </div>
</section>

<section class="selected-experience tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Selected Work</span>
      <h2>{{ homepage.selectedExperienceHeading }}</h2>
      <p>{{ homepage.selectedExperienceIntro }}</p>
    </div>
    {% set selectedExamples = collections.experienceStories | featuredStories(3) %}
    <div class="selected-feature-grid">
      {% for story in selectedExamples %}
      <a class="story-card selected-feature{% if loop.first %} selected-feature--lead{% endif %}" style="--feature-accent: var(--{{ ['forest','slate','sage'][loop.index0] }});" href="{{ story.url }}">
        <span class="card-category">{{ story.data.theme }} · {{ story.data.organisation }}</span>
        <h3>{{ story.data.title }}</h3>
        <p class="card-body">{{ story.data.card_summary or story.data.summary }}</p>
        {% if loop.first %}
        {% set leadImpact = story.data.impact | publicImpact %}
        {% if leadImpact.length %}
        <div class="card-metric">
          <span class="card-metric-value">{{ leadImpact[0].value }}</span>
          <span class="card-metric-label">{{ leadImpact[0].label }}</span>
        </div>
        {% endif %}
        {% if story.data.public_categories.length %}
        <p class="card-capabilities">{% for label in story.data.public_categories | limit(4) %}{{ label }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
        {% endif %}
        {% endif %}
        <span class="accent-card__link">Explore the story →</span>
      </a>
      {% endfor %}
    </div>
    <div class="section-footer">
      <a class="btn btn--text" href="/experience/">Explore the full career journey →</a>
    </div>
  </div>
</section>

{% set homeIdeas = collections.articles | limit(3) %}
{% if homeIdeas.length %}
<section class="thinking-teaser tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">How I Work and Think</span>
      <h2>{{ homepage.thinkingHeading }}</h2>
      <p>{{ homepage.thinkingSubheading }}</p>
    </div>

    <div class="card-grid">
      {% for idea in homeIdeas %}
      {% set ideaTerritory = idea.data.territory | territoryData %}
      <a class="article-card" href="{{ idea.url }}">
        {% if ideaTerritory %}<span class="card-category">{{ ideaTerritory.title }}</span>{% endif %}
        <h3>{{ idea.data.title }}</h3>
        <p class="card-body">{{ idea.data.excerpt }}</p>
        <div class="card-meta">{{ idea.data.date | readableDate }} · {{ idea.templateContent | readingTime }}</div>
        <span class="accent-card__link">Read the article →</span>
      </a>
      {% endfor %}
    </div>

    <div class="section-footer">
      <a class="btn btn--text" href="/thinking/">{{ homepage.thinkingCtaLabel or "View all articles →" }}</a>
      {% if site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}
      <a class="btn btn--text" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" style="margin-left: 1.5rem;">Continue the conversation on LinkedIn →</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="speaking-teaser tier-dominant section--dark">
  <div class="wrap split">
    <div>
      {{ ph.photo(photos["gulfood-speaker-card"], { sizes: "(max-width: 800px) 94vw, 440px" }) }}
    </div>
    <div>
      <span class="section-label">Voice</span>
      <h2>{{ homepage.speakingHeading }}</h2>
      <p>{{ homepage.speakingText }}</p>
      {% if speakingTopics.items.length %}
      <ul class="pill-list" style="margin-top: 1.5rem;">
        {% for topic in speakingTopics.items | limit(4) %}
        <li class="pill" style="background: transparent; border-color: rgba(255,255,255,0.3); color: var(--background);">{{ topic.title }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="teaser__ctas">
        <a class="btn btn--primary" href="/contact/?intent=speaking">Invite Parul to Speak →</a>
        <a class="btn btn--secondary" href="/speaking/">{{ homepage.speakingCtaLabel }}</a>
      </div>
    </div>
  </div>
</section>

<section class="final-cta tier-dominant">
  <svg class="final-cta__contour" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <circle cx="100" cy="100" r="60"></circle>
    <circle cx="100" cy="100" r="85"></circle>
    <circle cx="100" cy="100" r="98"></circle>
  </svg>
  <div class="wrap">
    {% if homepage.finalCtaEyebrow %}<span class="final-cta__eyebrow">{{ homepage.finalCtaEyebrow }}</span>{% endif %}
    <h2>{{ homepage.finalCtaHeading }}</h2>
    <p>{{ homepage.finalCtaText }}</p>
    <div class="final-cta__ctas">
      <a class="btn btn--primary" href="/contact/">{{ homepage.finalCtaPrimaryLabel }} →</a>
      <a class="btn btn--secondary" href="/contact/?intent=speaking">{{ homepage.finalCtaSpeakingLabel }} →</a>
      {% if site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}
      <a class="btn btn--text" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">{{ homepage.finalCtaSecondaryLabel }} ↗</a>
      {% endif %}
    </div>
    {% if homepage.opportunityLine %}
    <p class="final-cta__opportunity-line">{{ homepage.opportunityLine }}</p>
    {% endif %}
  </div>
</section>
