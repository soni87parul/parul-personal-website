---
title: Contact
layout: layouts/base.njk
seoKey: contact
---
{% set hasLinkedin = site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}

<section class="page-header page-header--tight contact-intro">
  <div class="wrap contact-wrap">
    <span class="eyebrow">Start a Conversation</span>
    <h1>Let's connect.</h1>
    <p>Have an opportunity, an idea, or something worth discussing? I'd love to hear from you.</p>
  </div>
</section>

<section class="contact-section">
  <div class="wrap contact-wrap">
    {#- Posted to /contact-submit.php on Hostinger, which emails the enquiry.
        Without JavaScript the browser posts normally and the script redirects
        to /contact/thank-you/ once the email is sent. With JavaScript,
        main.js posts the same fields and shows the success panel only when
        the script answers {"ok": true}. bot-field is a honeypot for spam. -#}
    <form class="contact-form" id="contactForm" name="contact" method="POST" action="/contact-submit.php">
      <input type="hidden" name="topic" id="referralTopic" value="">
      <p class="contact-honeypot" aria-hidden="true">
        <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off"></label>
      </p>

      <div class="form-row">
        <label for="reason">What would you like to connect about?</label>
        <select id="reason" name="reason" required aria-describedby="reason-error">
          <option value="">Select a reason</option>
          <option value="leadership">Leadership / Executive Opportunity</option>
          <option value="transformation">Business Transformation / Advisory</option>
          <option value="fractional">Fractional CXO / Startup Growth</option>
          <option value="speaking">Speaking / Panel / Event Invitation</option>
          <option value="collaboration">Investor / Board / Policy Collaboration</option>
          <option value="networking">Networking / General Conversation</option>
          <option value="other">Something Else</option>
        </select>
        <p class="field-error" id="reason-error" data-message="Please choose what you'd like to connect about." hidden></p>
      </div>

      <div class="form-grid-2">
        <div class="form-row">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" required maxlength="120" autocomplete="name" placeholder="Full name" aria-describedby="name-error">
          <p class="field-error" id="name-error" data-message="Please enter your name." hidden></p>
        </div>
        <div class="form-row">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="you@company.com" aria-describedby="email-error">
          <p class="field-error" id="email-error" data-message="Please enter a valid email address, like you@company.com." hidden></p>
        </div>
      </div>

      <div class="form-row">
        <label for="linkedin">LinkedIn profile <span class="optional">(optional)</span></label>
        <input type="url" id="linkedin" name="linkedin" maxlength="300" autocomplete="url" inputmode="url" placeholder="https://linkedin.com/in/..." aria-describedby="linkedin-error">
        <p class="field-error" id="linkedin-error" data-message="Please enter a full web address starting with https://, or leave this blank." hidden></p>
      </div>

      <div class="form-row">
        <label for="message">Tell me a little about it</label>
        <textarea id="message" name="message" rows="3" required minlength="10" maxlength="2000" placeholder="A few lines about your opportunity, idea or question are enough." aria-describedby="message-help message-error"></textarea>
        <p class="field-help" id="message-help">Keep it brief. We can discuss the details later.</p>
        <p class="field-error" id="message-error" data-message="Please add a short message (at least 10 characters)." hidden></p>
      </div>

      <div class="consent-row">
        <input type="checkbox" id="consent" name="consent" value="yes" required aria-describedby="consent-error">
        <label for="consent">I agree to my details being used to respond to this enquiry.</label>
      </div>
      <p class="field-error field-error--consent" id="consent-error" data-message="Please tick the box so I can respond to your enquiry." hidden></p>

      <div class="form-status form-status--error" id="contactError" role="alert" tabindex="-1" hidden>
        <p><strong>Sorry, your message didn't go through.</strong> Your details are still here. Please try again.</p>
      </div>

      <button type="submit" class="btn btn--primary contact-submit">Send your message →</button>
    </form>

    <div class="form-status form-status--success" id="contactSuccess" role="status" tabindex="-1" hidden>
      <h2>Thank you for reaching out!</h2>
      <p>Your message has been received. I'll review it and get back to you as soon as possible.</p>
    </div>

    {% if hasLinkedin %}
    <div class="contact-direct">
      <p class="contact-direct__label">Prefer to connect directly?</p>
      <a class="btn btn--text contact-direct__link" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">Connect with me on LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    {% endif %}
  </div>
</section>
