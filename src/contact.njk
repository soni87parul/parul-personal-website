---
title: Contact
layout: layouts/base.njk
seoTitle: Start a Conversation | Parul Soni Manvati
seoDescription: Tell me what you're working through. The more context you share, the more useful the first conversation can be.
---
{% import "partials/cta.njk" as cta %}

<section class="page-header page-header--tight">
  <div class="wrap">
    <span class="eyebrow">Start a Conversation</span>
    <h1>Tell me what you're working through.</h1>
    <p>The more context you share, the more useful the first conversation can be.</p>
    <p class="context-banner" id="contextBanner" hidden></p>
    {% if site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}
    <p style="margin-top: 0.75rem; color: var(--muted);">Prefer to connect first? <a class="btn--text btn" style="padding:0;" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">Connect with me on LinkedIn →</a></p>
    {% endif %}
  </div>
</section>

<section>
  <div class="wrap">
    <div class="contact-layout">
      <form class="contact-form" style="max-width: none;" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/thank-you/">
        <input type="hidden" name="form-name" value="contact">
        <input type="hidden" name="topic" id="referralTopic" value="">
        <p style="display:none">
          <label>Don't fill this out if you're human: <input name="bot-field"></label>
        </p>

        <div class="form-section">
          <h2 class="form-section-title">About you</h2>
          <p class="form-section-hint">So I know who I'm speaking with and can build a professional record of our conversation.</p>

          <div class="form-grid-2">
            <div class="form-row">
              <label for="full_name">Full Name *</label>
              <input type="text" id="full_name" name="full_name" required>
            </div>
            <div class="form-row">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" required>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-row">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" required>
            </div>
            <div class="form-row">
              <label for="company">Company / Organisation *</label>
              <input type="text" id="company" name="company" required placeholder="Or Independent / Self-employed / Not applicable">
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-row">
              <label for="role">Role / Designation</label>
              <input type="text" id="role" name="role">
            </div>
            <div class="form-row">
              <label for="linkedin">LinkedIn Profile</label>
              <input type="url" id="linkedin" name="linkedin" placeholder="https://linkedin.com/in/...">
            </div>
          </div>

          <div class="form-row">
            <label for="city_country">City / Country</label>
            <input type="text" id="city_country" name="city_country">
          </div>
        </div>

        <div class="form-section">
          <h2 class="form-section-title">What brings you here?</h2>

          <div class="form-row">
            <label for="opportunityType">Opportunity Type *</label>
            <select id="opportunityType" name="intent" required>
              <option value="">Select one</option>
              <optgroup label="Senior leadership &amp; transformation">
                <option value="leadership">Leadership / Executive Role</option>
                <option value="transformation">Transformation / CEO Office Mandate</option>
                <option value="board">Board / Independent Director</option>
              </optgroup>
              <optgroup label="Also welcome">
                <option value="ceo-advisory">CEO / Founder Advisory</option>
                <option value="investor">Investor / Portfolio Company Support</option>
                <option value="government">Government / Policy Project</option>
                <option value="speaking">Speaking</option>
                <option value="collaboration">Collaboration</option>
                <option value="other">Something Else</option>
              </optgroup>
            </select>
          </div>

          <fieldset class="conditional-fieldset" data-opportunity-group="leadership">
            <legend>Leadership / Executive Role</legend>
            <div class="form-grid-2">
              <div class="form-row"><label for="l_organisation">Organisation</label><input type="text" id="l_organisation" name="l_organisation"></div>
              <div class="form-row"><label for="l_role">Role / Mandate</label><input type="text" id="l_role" name="l_role"></div>
            </div>
            <div class="form-grid-2">
              <div class="form-row"><label for="l_location">Location</label><input type="text" id="l_location" name="l_location"></div>
              <div class="form-row"><label for="l_employment">Employment Model</label><input type="text" id="l_employment" name="l_employment"></div>
            </div>
            <div class="form-row"><label for="l_why">Why are you reaching out to Parul?</label><textarea id="l_why" name="l_why"></textarea></div>
          </fieldset>

          <fieldset class="conditional-fieldset" data-opportunity-group="transformation">
            <legend>Transformation Project</legend>
            <div class="form-grid-2">
              <div class="form-row"><label for="t_size">Approximate Organisation Size</label><input type="text" id="t_size" name="t_size"></div>
              <div class="form-row"><label for="t_functions">Functions Involved</label><input type="text" id="t_functions" name="t_functions"></div>
            </div>
            <div class="form-row">
              <label for="t_stage">Current Stage</label>
              <select id="t_stage" name="t_stage">
                <option value="">Select one</option>
                <option value="diagnosing">Diagnosing</option>
                <option value="designing">Designing</option>
                <option value="implementing">Implementing</option>
                <option value="stuck">Stuck in execution</option>
              </select>
            </div>
          </fieldset>

          <fieldset class="conditional-fieldset" data-opportunity-group="investor">
            <legend>Investor / Portfolio Support</legend>
            <div class="form-row"><label for="i_fund">Fund / Investment Organisation</label><input type="text" id="i_fund" name="i_fund"></div>
            <div class="form-grid-2">
              <div class="form-row"><label for="i_stage">Portfolio Company Stage</label><input type="text" id="i_stage" name="i_stage"></div>
              <div class="form-row"><label for="i_challenge">Nature of Challenge</label><input type="text" id="i_challenge" name="i_challenge"></div>
            </div>
          </fieldset>

          <fieldset class="conditional-fieldset" data-opportunity-group="board">
            <legend>Board Opportunity</legend>
            <div class="form-grid-2">
              <div class="form-row"><label for="b_organisation">Organisation</label><input type="text" id="b_organisation" name="b_organisation"></div>
              <div class="form-row"><label for="b_role">Board / Advisory Role Type</label><input type="text" id="b_role" name="b_role"></div>
            </div>
            <div class="form-grid-2">
              <div class="form-row"><label for="b_sector">Sector</label><input type="text" id="b_sector" name="b_sector"></div>
              <div class="form-row"><label for="b_mandate">Expected Mandate</label><input type="text" id="b_mandate" name="b_mandate"></div>
            </div>
          </fieldset>

          <fieldset class="conditional-fieldset" data-opportunity-group="government">
            <legend>Government / Policy</legend>
            <div class="form-row"><label for="g_institution">Institution</label><input type="text" id="g_institution" name="g_institution"></div>
            <div class="form-grid-2">
              <div class="form-row"><label for="g_programme">Programme / Policy Area</label><input type="text" id="g_programme" name="g_programme"></div>
              <div class="form-row"><label for="g_nature">Nature of Engagement</label><input type="text" id="g_nature" name="g_nature"></div>
            </div>
          </fieldset>

          <fieldset class="conditional-fieldset" data-opportunity-group="speaking">
            <legend>Speaking</legend>
            <div class="form-grid-2">
              <div class="form-row"><label for="sp_event">Event / Organisation</label><input type="text" id="sp_event" name="sp_event"></div>
              <div class="form-row"><label for="sp_date">Date</label><input type="text" id="sp_date" name="sp_date"></div>
            </div>
            <div class="form-grid-2">
              <div class="form-row"><label for="sp_location">Location / Online</label><input type="text" id="sp_location" name="sp_location"></div>
              <div class="form-row"><label for="sp_audience">Audience</label><input type="text" id="sp_audience" name="sp_audience"></div>
            </div>
            <div class="form-grid-2">
              <div class="form-row"><label for="sp_topic">Topic</label><input type="text" id="sp_topic" name="sp_topic"></div>
              <div class="form-row"><label for="sp_paid">Paid / Honorarium / To Be Discussed</label><input type="text" id="sp_paid" name="sp_paid"></div>
            </div>
          </fieldset>
        </div>

        <div class="form-section">
          <h2 class="form-section-title">Tell me about the situation</h2>

          <div class="form-row">
            <label for="objective">What are you trying to accomplish? *</label>
            <textarea id="objective" name="objective" required></textarea>
          </div>
          <div class="form-row">
            <label for="current_state">What is happening today? *</label>
            <textarea id="current_state" name="current_state" required></textarea>
          </div>
          <div class="form-row">
            <label for="constraint">What feels like the biggest constraint? *</label>
            <textarea id="constraint" name="constraint" required></textarea>
          </div>
          <div class="form-row">
            <label for="desired_outcome">What would a successful outcome look like? *</label>
            <textarea id="desired_outcome" name="desired_outcome" required></textarea>
          </div>
          <div class="form-row">
            <label for="urgency">Why does this need attention now? *</label>
            <textarea id="urgency" name="urgency" required></textarea>
          </div>
        </div>

        <div class="form-section">
          <h2 class="form-section-title">Final context</h2>
          <p class="form-section-hint">Optional, but useful if you have it to hand.</p>

          <div class="form-row">
            <label for="decision_makers">Who is involved in making the decision?</label>
            <input type="text" id="decision_makers" name="decision_makers">
          </div>
          <div class="form-row">
            <label for="additional_context">Anything else I should understand before we speak?</label>
            <textarea id="additional_context" name="additional_context"></textarea>
          </div>
        </div>

        <div class="consent-row">
          <input type="checkbox" id="consent" name="consent" required>
          <label for="consent">I understand that the information I provide will be used to review my enquiry, contact me about it, and maintain a record of our professional interaction.</label>
        </div>

        <button type="submit" class="btn btn--primary">Send message</button>
        <p class="form-note">This form is handled by Netlify Forms. Submissions arrive in your Netlify dashboard and can be forwarded to your email.</p>
      </form>

      <aside class="contact-side">
        <h2>What happens next</h2>
        <ol>
          <li>You share the context.</li>
          <li>I review it personally.</li>
          <li>If there is a useful reason to speak, I will follow up.</li>
        </ol>
        {{ cta.linkedinLink() }}
      </aside>
    </div>
  </div>
</section>
