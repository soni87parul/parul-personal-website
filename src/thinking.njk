---
title: Thinking
layout: layouts/base.njk
seoTitle: Thinking | Parul Soni Manvati
seoDescription: "Ideas shaped by the problems I work on: transformation, AI, operating models, business building, future industries and the systems around them."
---
{% import "partials/cta.njk" as cta %}

<section class="page-header page-header--tight">
  <div class="wrap">
    <span class="eyebrow">Thinking</span>
    <h1>Ideas shaped by the problems I work on.</h1>
    <p>My ideas come from the work itself: how I diagnose problems, design responses, build systems and learn from what happens next.</p>
    <div class="hero__ctas" style="margin-top: 1.75rem;">
      <a class="btn btn--primary" href="/contact/">Start a Conversation →</a>
      {{ cta.linkedinLink() }}
    </div>
  </div>
</section>

<section class="flywheel-section">
  <div class="wrap">
    <div class="section-heading" style="text-align: center; margin-left: auto; margin-right: auto;">
      <h2>How my thinking evolves</h2>
      <p style="margin-left: auto; margin-right: auto;">Most of my ideas start in the work itself.</p>
    </div>
    {% include "partials/thinking-ribbon.njk" %}
  </div>
</section>

{% set territoryIcons = ["⚙", "◎", "⌕", "▲", "✦", "◐"] %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading" style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <span class="section-label">Territories</span>
        <h2>What I keep coming back to. Click to filter.</h2>
      </div>
      <button type="button" class="btn btn--text" data-territory-filter="all" data-territory-reset-link hidden>Show all articles ×</button>
    </div>
    <div class="territory-grid" data-thinking-filter-bar>
      {% for t in thinkingTerritories %}
      <button type="button" class="territory-card" data-territory-filter="{{ t.slug }}" style="--territory-accent: var(--{{ t.accent }});">
        <span class="territory-card__icon" aria-hidden="true">{{ territoryIcons[loop.index0] }}</span>
        <span class="territory-card__title">{{ t.title }}</span>
        <span class="territory-card__desc">{{ t.description }}</span>
      </button>
      {% endfor %}
    </div>
    <p class="filter-empty-state" data-thinking-empty-state hidden style="margin-top: 1.5rem;">No articles match this territory yet. <a href="/thinking/" data-thinking-filter-reset>View all →</a></p>
  </div>
</section>

{% set allArticles = collections.articles %}
{% set leadArticle = allArticles | limit(1) %}
{% set supportArticles = allArticles | sliceArr(1, 3) %}
{% set remainingArticles = allArticles | sliceArr(3, allArticles.length) %}

{% if allArticles.length %}
<section class="tier-dominant">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Articles</span>
      <h2>Articles</h2>
    </div>

    <div class="articles-layout">
      {% if leadArticle.length %}
      {% set idea = leadArticle[0] %}
      {% set ideaTerritory = idea.data.territory | territoryData %}
      <a class="article-lead" data-thinking-card{% if ideaTerritory %} data-territory="{{ ideaTerritory.slug }}" style="--article-accent: var(--{{ ideaTerritory.accent }});"{% endif %} href="{{ idea.url }}">
        {% if ideaTerritory %}<span class="card-category">{{ ideaTerritory.title }}</span>{% endif %}
        <h3>{{ idea.data.title }}</h3>
        <p>{{ idea.data.excerpt }}</p>
        <div class="card-meta" style="margin-top: 0.9rem;">{{ idea.data.date | readableDate }} · {{ idea.templateContent | readingTime }}</div>
      </a>
      {% endif %}

      {% if supportArticles.length %}
      <div class="article-support-stack">
        {% for article in supportArticles %}
        {% set territory = article.data.territory | territoryData %}
        <a class="article-support" data-thinking-card{% if territory %} data-territory="{{ territory.slug }}" style="--article-accent: var(--{{ territory.accent }});"{% endif %} href="{{ article.url }}">
          {% if territory %}<span class="card-category" style="margin-bottom: 0.3rem;">{{ territory.title }}</span>{% endif %}
          <h3>{{ article.data.title }}</h3>
          <p>{{ article.data.excerpt }}</p>
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if remainingArticles.length %}
    <div class="articles-remaining-grid">
      {% for article in remainingArticles %}
      {% set territory = article.data.territory | territoryData %}
      <a class="article-card" data-thinking-card{% if territory %} data-territory="{{ territory.slug }}"{% endif %} href="{{ article.url }}">
        {% if territory %}<span class="card-category">{{ territory.title }}</span>{% endif %}
        <h3>{{ article.data.title }}</h3>
        <p class="card-body">{{ article.data.excerpt }}</p>
        <div class="card-meta">{{ article.data.date | readableDate }} · {{ article.templateContent | readingTime }}</div>
      </a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% else %}
<section>
  <div class="wrap">
    <div class="empty-state">No published articles yet. Add one via Admin → Thinking.</div>
  </div>
</section>
{% endif %}

<section class="tier-supporting">
  <div class="wrap">
    {% include "partials/linkedin-cta.njk" %}
  </div>
</section>
