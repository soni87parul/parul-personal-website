{% set loopAccents = ["terracotta", "gold", "slate", "sage", "forest"] %}
{% set loopPositions = [
  { x: 50, y: 8 },
  { x: 89.94, y: 36.98 },
  { x: 74.7, y: 83.98 },
  { x: 25.3, y: 83.98 },
  { x: 10.06, y: 36.98 }
] %}
<div class="loop-diagram" data-loop-diagram role="img" aria-label="A loop: Figure Out, Design, Build, Scale, Transform, and back to Figure Out.">
  <svg class="loop-diagram__svg" viewBox="0 0 100 100" aria-hidden="true">
    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <path class="loop-diagram__arc" marker-end="url(#loop-arrow)" d="M50,8 A42,42 0 0,1 89.94,36.98"></path>
    <path class="loop-diagram__arc" marker-end="url(#loop-arrow)" d="M89.94,36.98 A42,42 0 0,1 74.7,83.98"></path>
    <path class="loop-diagram__arc" marker-end="url(#loop-arrow)" d="M74.7,83.98 A42,42 0 0,1 25.3,83.98"></path>
    <path class="loop-diagram__arc" marker-end="url(#loop-arrow)" d="M25.3,83.98 A42,42 0 0,1 10.06,36.98"></path>
    <path class="loop-diagram__arc" marker-end="url(#loop-arrow)" d="M10.06,36.98 A42,42 0 0,1 50,8"></path>
  </svg>
  <div class="loop-diagram__nodes">
    {% for stage in homepage.methodStages %}
    <div class="loop-diagram__node" tabindex="0" style="left: {{ loopPositions[loop.index0].x }}%; top: {{ loopPositions[loop.index0].y }}%; --loop-accent: var(--{{ loopAccents[loop.index0] }});">
      <span class="loop-diagram__node-dot"></span>
      <span class="loop-diagram__node-title">{{ stage.title }}</span>
      <p class="loop-diagram__node-detail">{{ stage.action }}. &ldquo;{{ stage.example }}&rdquo;</p>
    </div>
    {% endfor %}
  </div>
</div>
