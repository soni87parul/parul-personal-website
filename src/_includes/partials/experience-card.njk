{% macro storyCard(story, capabilityList, size, tint) %}
{% set publicImpactItems = story.data.impact | publicImpact %}
<a class="story-card{% if size %} story-card--{{ size }}{% endif %}{% if tint %} story-card--{{ tint }}{% endif %}" data-story-card data-broad-filters="{{ story.data | storyBroadFilterSlugs | join(',') }}" href="{{ story.url }}">
  <span class="card-category">{{ story.data.theme }} · {{ story.data.organisation }}</span>
  <h3>{{ story.data.title }}{% if story.data.status_label %} <span class="status-badge">{{ story.data.status_label }}</span>{% endif %}</h3>
  {% set cardText = story.data.card_summary or story.data.summary %}
  {% if cardText %}<p class="card-body">{{ cardText }}</p>{% endif %}
  {% if publicImpactItems.length %}
  <div class="card-metric">
    <span class="card-metric-value">{{ publicImpactItems[0].value }}</span>
    <span class="card-metric-label">{{ publicImpactItems[0].label }}</span>
  </div>
  {% endif %}
  {% if story.data.public_categories.length %}
  <p class="card-capabilities">{% for label in story.data.public_categories | limit(3) %}{{ label }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
  {% else %}
    {% set caps = story.data.capabilities | capabilityNames(capabilityList) | limit(3) %}
    {% if caps.length %}
    <p class="card-capabilities">{% for c in caps %}{{ c.name }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {% endif %}
  {% endif %}
  <div class="card-footer-row">
    <span class="accent-card__link">Explore the story →</span>
  </div>
</a>
{% endmacro %}
