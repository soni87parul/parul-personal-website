<header class="site-header" id="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href="/">{{ site.name | upper }}</a>

    <button class="site-header__toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span class="hamburger"></span>
    </button>

    <nav class="site-header__nav" id="site-nav">
      <ul>
        {% for item in navigation.items %}
        <li><a href="{{ item.link }}"{% if page.url and page.url.startsWith(item.link) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      {% if site.linkedin and site.linkedin != "[CONTENT NEEDED — LinkedIn profile URL]" %}
      <a class="site-header__linkedin" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="Connect on LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
      {% endif %}
      <a class="site-header__cta" href="/contact/">Start a Conversation →</a>
    </nav>
  </div>
</header>
