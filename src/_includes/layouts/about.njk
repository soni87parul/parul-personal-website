---
layout: layouts/base.njk
---
{% import "partials/recommendation-card.njk" as recs %}
{% import "partials/media-placeholder.njk" as media %}
{% import "partials/company-logo.njk" as companyLogo %}
{% import "partials/photo.njk" as ph %}

<section class="page-header page-header--tight">
  <div class="wrap grid-12 about-hero__grid">
    <div class="col-8 about-hero__copy">
      {% if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
      <h1>{{ title }}</h1>
      {% if shortIntro %}<p>{{ shortIntro }}</p>{% endif %}
    </div>
    <div class="col-4 about-portrait" style="max-width: none; margin-left: 0;">
      {% if portraitPhoto and photos[portraitPhoto] %}
      <div class="about-portrait__frame">{{ ph.photo(photos[portraitPhoto], { eager: true, sizes: "(max-width: 800px) 220px, 380px" }) }}</div>
      {% else %}
      {{ media.placeholder("Executive portrait, natural setting", "4/5") }}
      {% endif %}
    </div>
  </div>
</section>

{% if proofCards.length %}
<section class="identity-strip-section tier-supporting">
  <div class="wrap">
    <div class="identity-strip identity-strip--thumbs" data-identity-strip>
      {% for card in proofCards %}
      <div class="identity-strip__zone" tabindex="0" style="--identity-accent: var(--{{ card.accent }});">
        {% if card.image %}
        <span class="identity-strip__thumb">
          <picture>
            <source type="image/webp" srcset="/assets/images/visuals/{{ card.image }}-600.webp">
            <img src="/assets/images/visuals/{{ card.image }}-600.jpg" width="600" height="600" alt="{{ card.imageAlt or '' }}" loading="lazy" decoding="async">
          </picture>
        </span>
        {% endif %}
        <span class="identity-strip__text">
          <span class="identity-strip__title">{{ card.title }}</span>
          <span class="identity-strip__desc">{{ card.description }}</span>
        </span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="tier-dominant">
  <div class="wrap">
    {% if threadThroughCareer %}
    <div class="section-heading">
      <span class="section-label">The Thread Through My Career</span>
      <h2 style="font-size: clamp(1.5rem, 3vw, 2.1rem); max-width: 48ch;">{{ threadThroughCareer }}</h2>
    </div>
    {% endif %}

    {% if careerChapters.length %}
    <div class="impact-strip has-active career-strip" data-career-strip>
      <div class="impact-strip__logos career-strip__logos" role="tablist" aria-label="Career chapters">
        {% for chapter in careerChapters %}
        <button type="button" role="tab" class="impact-strip__logo-btn career-strip__tab{% if loop.first %} is-active{% endif %}"
          id="career-tab-{{ loop.index0 }}" aria-controls="career-panel-{{ loop.index0 }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}"
          aria-label="{{ chapter.company }}">
          {% if chapter.logoName %}{{ companyLogo.logo({ name: chapter.logoName, color: chapter.logoColor, logo: chapter.logoAsset }) }}{% else %}<span class="career-strip__name">{{ chapter.company }}</span>{% endif %}
          {% if chapter.logoName2 %}{{ companyLogo.logo({ name: chapter.logoName2, color: chapter.logoColor2, logo: chapter.logoAsset2 }) }}{% endif %}
        </button>
        {% endfor %}
      </div>
      <div class="career-strip__panels">
        {% for chapter in careerChapters %}
        <div class="career-strip__panel{% if loop.first %} is-active{% endif %}{% if not chapter.metricValue and not chapter.link %} career-strip__panel--solo{% endif %}" role="tabpanel"
          id="career-panel-{{ loop.index0 }}" aria-labelledby="career-tab-{{ loop.index0 }}"
          style="--panel-accent: {{ chapter.logoColor or 'var(--accent)' }};">
          <span class="career-strip__company">{{ chapter.company }}</span>
          <h3 class="career-strip__headline">{{ chapter.label }}</h3>
          <div class="career-strip__body">
            <p>{{ chapter.problem }}</p>
            {% if chapter.learning %}<p class="career-strip__learning"><strong>Learning:</strong> {{ chapter.learning }}</p>{% endif %}
          </div>
          {% if chapter.metricValue or chapter.link %}
          <div class="career-strip__aside">
            {% if chapter.metricValue %}
            <div class="career-strip__metric">
              <span class="career-strip__metric-value">{{ chapter.metricValue }}</span>
              <span class="career-strip__metric-label">{{ chapter.metricLabel }}</span>
            </div>
            {% endif %}
            {% if chapter.link %}<a class="career-strip__link" href="{{ chapter.link }}">Read the full story →</a>{% endif %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if methodologyReference %}
    <p class="about-methodology-reference"><a href="/#method">{{ methodologyReference }}</a></p>
    {% endif %}
  </div>
</section>

{% if aboutThinking.chapters.length %}
<section class="tier-secondary about-thinking">
  <div class="wrap">
    <div class="section-heading about-thinking__head">
      <span class="section-label">{{ aboutThinking.label }}</span>
      <h2>{{ aboutThinking.title }}</h2>
      {% if aboutThinking.intro %}<p>{{ aboutThinking.intro }}</p>{% endif %}
    </div>
    <div class="thinking-list">
      {% for chapter in aboutThinking.chapters %}
      {% set solo = chapter.photos.length == 1 %}
      <article class="thinking-row">
        <div class="thinking-row__text">
          <h3>{{ chapter.heading }}</h3>
          <p>{{ chapter.line }}</p>
        </div>
        <div class="thinking-row__visual">
          <div class="thinking__photos{% if solo %} thinking__photos--solo{% endif %}" style="--sum: {{ chapter.photos | photoStripRatio }};">
            {% for item in chapter.photos %}
            {% set tilePhoto = photos[item.photo] %}
            {% if tilePhoto %}
            {% set rr = tilePhoto.ratio.split("/") %}
            <figure class="thinking__photo" style="--ar: {{ rr[0] / rr[1] }};">
              {{ ph.photo(tilePhoto, { fill: true, sizes: "(max-width: 640px) 46vw, 300px" }) }}
              {% if item.caption %}<figcaption>{{ item.caption }}</figcaption>{% endif %}
            </figure>
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if education %}
<section class="tier-supporting">
  <div class="wrap">
    <div class="section-heading" style="margin-bottom: 1rem;">
      <span class="section-label">Education</span>
    </div>
    <p style="color: var(--muted); max-width: 60ch;">{{ education }}</p>
  </div>
</section>
{% endif %}

{% set allRecs = collections.recommendations %}
{% if allRecs.length %}
<section class="teaser tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <span class="section-label">Recommendations</span>
      <h2>What people I've worked with say</h2>
    </div>
    <div class="quote-block" data-quote-block>
      <div class="quote-block__featured" data-quote-featured>
        {% for rec in allRecs %}
        <blockquote data-quote-index="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
          <div class="quote-attribution">
            <cite class="quote-attribution__name">{{ rec.data.name }}</cite>
            {% if rec.data.role %}<span class="quote-attribution__role">{{ rec.data.role }}</span>{% endif %}
            {% if rec.data.organisation %}<span class="quote-attribution__org">{{ rec.data.organisation }}</span>{% endif %}
          </div>
          <p>&ldquo;{{ rec.data.short_excerpt or rec.data.quote }}&rdquo;</p>
        </blockquote>
        {% endfor %}
      </div>
      <div class="quote-selector" data-quote-selector>
        {% for rec in allRecs %}
        <button type="button" data-quote-index="{{ loop.index0 }}"{% if loop.first %} class="is-active"{% endif %}>{{ rec.data.name }}</button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="tier-supporting">
  <div class="wrap">
    {% include "partials/linkedin-cta.njk" %}
  </div>
</section>
