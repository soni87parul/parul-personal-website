---
layout: layouts/base.njk
---
<section class="page-header">
  <div class="wrap">
    <span class="eyebrow">{{ theme }}{% if organisation %} · {{ organisation }}{% endif %}{% if year_or_period %} · {{ year_or_period }}{% endif %}</span>
    <h1>{{ title }}{% if status_label %} <span class="status-badge">{{ status_label }}</span>{% endif %}</h1>
    {% if summary %}<p>{{ summary }}</p>{% endif %}

    {% if public_categories.length %}
    <ul class="pill-list" style="margin-top: 1.25rem;">
      {% for label in public_categories %}
      <li class="pill">{{ label }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% set publicImpactItems = impact | publicImpact %}
    {% if publicImpactItems.length %}
    <div class="card-metric" style="max-width: 420px; margin-top: 1.75rem;">
      <span class="card-metric-value">{{ publicImpactItems[0].value }}</span>
      <span class="card-metric-label">{{ publicImpactItems[0].label }}{% if publicImpactItems[0].context %} ({{ publicImpactItems[0].context }}){% endif %}</span>
    </div>
    {% endif %}
  </div>
</section>

<section>
  <div class="wrap">
    {% if featured_image %}
    <div class="hero__image-wrap" style="aspect-ratio: 16/9; margin-bottom: 3rem;">
      <img src="{{ featured_image }}" alt="{{ featured_image_alt or title }}">
    </div>
    {% endif %}

    <div class="prose">
      {% if problem %}
      <h2>The Problem</h2>
      <p>{{ problem }}</p>
      {% endif %}

      {% if why_it_mattered %}
      <h2>Why It Mattered</h2>
      <p>{{ why_it_mattered }}</p>
      {% endif %}

      {% if ("figure-out" in methodology_stages and figure_out) or ("design" in methodology_stages and design) or ("build" in methodology_stages and build) or ("scale" in methodology_stages and scale) or ("transform" in methodology_stages and transform) %}
      <h2>How I Approached It</h2>
      {% if "figure-out" in methodology_stages and figure_out %}
      <h3>Figure Out</h3>
      <p>{{ figure_out }}</p>
      {% endif %}
      {% if "design" in methodology_stages and design %}
      <h3>Design</h3>
      <p>{{ design }}</p>
      {% endif %}
      {% if "build" in methodology_stages and build %}
      <h3>Build</h3>
      <p>{{ build }}</p>
      {% endif %}
      {% if "scale" in methodology_stages and scale %}
      <h3>Scale</h3>
      <p>{{ scale }}</p>
      {% endif %}
      {% if "transform" in methodology_stages and transform %}
      <h3>Transform</h3>
      <p>{{ transform }}</p>
      {% endif %}
      {% endif %}

      {{ content | safe }}

      {% if takeaway %}
      <h2>My Takeaway</h2>
      <p>{{ takeaway }}</p>
      {% endif %}
    </div>

    {% set relevantRecs = related_recommendations | recommendationsByRefs(collections.recommendations) %}
    {% if relevantRecs.length %}
    {% import "partials/recommendation-card.njk" as recs %}
    <div style="margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--border);">
      <span class="eyebrow" style="display: block; margin-bottom: 1.25rem;">In their words</span>
      {% for rec in relevantRecs %}
        {{ recs.quote(rec, true) }}
      {% endfor %}
    </div>
    {% endif %}

    {% set storyCapabilities = capabilities | capabilityNames(collections.capabilityList) %}
    {% if storyCapabilities.length %}
    <div style="margin-top: 2.5rem;">
      <span class="eyebrow" style="display: block;">Related Capabilities</span>
      <ul class="pill-list" style="margin-top: 0.75rem;">
        {% for cap in storyCapabilities %}
        {% set targetFilters = [cap.slug] | broadFilterSlugs %}
        <li><a class="pill" href="/experience/{% if targetFilters.length %}?capability={{ targetFilters[0] }}{% endif %}">{{ cap.name }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% set next = collections.experienceStories | nextStory(page.url) %}
    {% if next %}
    <div class="section-footer" style="text-align: left; margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 2rem;">
      <span class="eyebrow">Next story</span>
      <p style="margin-top: 0.5rem;"><a class="btn btn--text" href="{{ next.url }}">{{ next.data.title }} →</a></p>
    </div>
    {% endif %}

    {% include "partials/linkedin-cta.njk" %}

    <div class="section-footer" style="text-align: left; margin-top: 2rem; display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
      <a class="btn btn--primary" href="/contact/">Start a Conversation</a>
      <a class="btn btn--text" href="/experience/">← Back to all experience</a>
    </div>
  </div>
</section>
