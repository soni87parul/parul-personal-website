---
layout: layouts/base.njk
---
{% import "partials/cta.njk" as cta %}
{% set territory = territory | territoryData %}
<section class="page-header">
  <div class="wrap">
    <span class="eyebrow">{{ territory.title if territory else category }}</span>
    <h1>{{ title }}</h1>
    <p class="article-deck">{{ subtitle or excerpt }}</p>
    <p class="card-meta" style="margin-top: 1rem;">{{ date | readableDate }} · {{ content | readingTime }}</p>
  </div>
</section>

<section>
  <div class="wrap">
    {% if coverImage %}
    <div class="hero__image-wrap" style="aspect-ratio: 16/9; margin-bottom: 3rem;">
      <img src="{{ coverImage }}" alt="{{ coverImageAlt or title }}">
    </div>
    {% endif %}

    <div class="prose">
      {{ content | safe }}
    </div>

    {% if tags.length %}
    <div class="pill-list">
      {% for tag in tags %}
      <span class="pill">{{ tag }}</span>
      {% endfor %}
    </div>
    {% endif %}

    {% set relatedStory = related_experience | experienceByRef(collections.experienceStories) %}
    {% if relatedStory %}
    <a class="from-the-field" href="{{ relatedStory.url }}">
      <span class="from-the-field__label">From the Field</span>
      <p>{% if from_the_field_context %}This idea came from work I did while {{ from_the_field_context }}{% else %}This idea came from work I did on {{ relatedStory.data.title | lower }}{% endif %}.</p>
      <span class="from-the-field__link">Read the Experience story →</span>
    </a>
    {% endif %}

    {% if takeaway %}
    <div class="takeaway-block">
      <span class="eyebrow">Closing takeaway</span>
      <p>{{ takeaway }}</p>
    </div>
    {% endif %}

    {% set contactHref = "/contact/?intent=" + contact_intent + "&topic=" + contact_topic if contact_intent and contact_topic else "/contact/" %}
    <div class="article-cta-row">
      {% if relatedStory %}<a class="btn btn--secondary" href="{{ relatedStory.url }}">Read the {{ relatedStory.data.organisation }} Experience story →</a>{% endif %}
      <a class="btn btn--primary" href="{{ contactHref }}">Start a Conversation →</a>
      {{ cta.linkedinLink() }}
    </div>

    {% if linkedin_post_url %}
    <p style="margin-top: 1rem;"><a class="btn btn--text" href="{{ linkedin_post_url }}" target="_blank" rel="noopener noreferrer">Discuss this on LinkedIn →</a></p>
    {% endif %}

    <div class="section-footer" style="text-align: left; margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 2rem;">
      <a class="btn btn--text" href="/thinking/">← Back to all thinking</a>
    </div>
  </div>
</section>
