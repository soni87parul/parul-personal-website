---
title: Advisory
layout: layouts/base.njk
seoTitle: Advisory | Parul Soni Manvati
seoDescription: When the problem is bigger than a meeting. I work through the trade-offs with leadership, design a response and help turn it into execution.
---
{% import "partials/cta.njk" as cta %}

<section class="page-header page-header--tight">
  <div class="wrap">
    <span class="eyebrow">{{ advisory.heroEyebrow }}</span>
    <h1>{{ advisory.heroHeading }}</h1>
    <p>{{ advisory.heroIntro }}</p>
    <div class="hero__ctas" style="margin-top: 1.75rem;">
      <a class="btn btn--primary" href="/contact/">Start a Conversation →</a>
      {{ cta.linkedinLink() }}
    </div>
  </div>
</section>

{% set situations = advisory.situations | selectattr("enabled") | sort(attribute="order") | publiclySafe %}
{% if situations.length %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <h2>{{ advisory.positioningHeading }}</h2>
    </div>
    <div class="card-grid">
      {% for s in situations %}
      <a class="accent-card accent-card--{{ s.accent }}" href="/contact/?intent={{ s.contactIntent }}&topic={{ s.contactTopic }}">
        <h3>{{ s.title }}</h3>
        <p>{{ s.description }}</p>
        <span class="accent-card__link">Discuss this →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set engagementTypes = advisory.engagementTypes | selectattr("enabled") | sort(attribute="order") | publiclySafe %}
{% if engagementTypes.length %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <h2>{{ advisory.engagementHeading }}</h2>
    </div>
    <div class="engagement-tiles">
      {% for e in engagementTypes %}
      {% set engagementHref = "/contact/?intent=" + e.contactIntent + "&topic=" + e.contactTopic if e.contactTopic else "/contact/?intent=" + e.contactIntent %}
      <a class="engagement-tile" href="{{ engagementHref }}">
        <h3>{{ e.title }}</h3>
        <p>{{ e.description }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set opportunities = advisory.opportunities | sort(attribute="order") %}
{% if opportunities.length %}
<section class="tier-dominant teaser">
  <div class="wrap">
    <div class="section-heading">
      <h2>{{ advisory.otherConversationsHeading }}</h2>
    </div>
    <div class="opportunity-grid">
      {% for o in opportunities %}
      <a class="opportunity-block opportunity-block--{{ o.accent }}" href="/contact/?intent={{ o.contactIntent }}">
        <span class="opportunity-block__label">{{ o.title }}</span>
        <p>{{ o.description }}</p>
      </a>
      {% endfor %}
    </div>
    <div class="teaser__ctas" style="margin-top: 2rem;">
      <a class="btn btn--secondary" href="/speaking/">Explore Speaking →</a>
      <a class="btn btn--primary" href="/contact/">{{ advisory.finalCtaPrimaryLabel or "Start a Conversation" }} →</a>
      {{ cta.linkedinLink(advisory.linkedinCtaLabel + " →" if advisory.linkedinCtaLabel else null) }}
    </div>
  </div>
</section>
{% endif %}
