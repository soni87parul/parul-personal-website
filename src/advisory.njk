---
title: Advisory
layout: layouts/base.njk
seoKey: advisory
---
{% import "partials/cta.njk" as cta %}

<section class="page-header page-header--tight">
  <div class="wrap grid-12 advisory-hero">
    <div class="col-5">
      <span class="eyebrow">{{ advisory.heroEyebrow }}</span>
      <h1>{{ advisory.heroHeading }}</h1>
      <p>{{ advisory.heroIntro }}</p>
      <div class="hero__ctas" style="margin-top: 1.75rem;">
        <a class="btn btn--primary" href="/contact/">Start a Conversation →</a>
        {{ cta.linkedinLink() }}
      </div>
    </div>
    <div class="col-7">
      <figure class="advisory-visual" data-reveal>
        <picture>
          <source type="image/webp" srcset="/assets/images/visuals/advisory-ecosystem-1000.webp 1000w, /assets/images/visuals/advisory-ecosystem-1600.webp 1600w, /assets/images/visuals/advisory-ecosystem-2200.webp 2200w" sizes="(max-width: 860px) 94vw, 56vw">
          <img
            src="/assets/images/visuals/advisory-ecosystem-1600.jpg"
            srcset="/assets/images/visuals/advisory-ecosystem-1000.jpg 1000w, /assets/images/visuals/advisory-ecosystem-1600.jpg 1600w, /assets/images/visuals/advisory-ecosystem-2200.jpg 2200w"
            sizes="(max-width: 860px) 94vw, 56vw"
            width="3348" height="1880"
            alt="Illustration showing an interconnected business system extending beyond a meeting room: people, strategy, technology, regulation and policy, industry and partners, markets and customers, talent and organisation, capital and investment, supply chain and operations, and execution."
            loading="eager" decoding="async" fetchpriority="high">
        </picture>
        <ul class="advisory-visual__labels" aria-hidden="true">
          <li style="left: 48.2%; top: 7.6%;">People</li>
          <li style="left: 68.8%; top: 11%;">Strategy</li>
          <li class="is-right" style="right: 82%; top: 15.5%;">Technology</li>
          <li class="is-right" style="right: 3%; top: 17.8%;">Regulation &amp;<br>Policy</li>
          <li class="is-right" style="left: 0.8%; top: 30.3%;">Industry<br>&amp; Partners</li>
          <li class="is-right" style="right: 2.2%; top: 35.8%;">Markets &amp;<br>Customers</li>
          <li class="is-right" style="left: 0.8%; top: 50.9%;">Talent &amp;<br>Organisation</li>
          <li style="left: 85.2%; top: 58.1%;">Capital &amp;<br>Investment</li>
          <li style="left: 77.1%; top: 73.2%;">Supply Chain<br>&amp; Operations</li>
          <li style="left: 40.7%; top: 81.5%;">Execution</li>
        </ul>
      </figure>
    </div>
  </div>
</section>

{% set situations = advisory.situations | selectattr("enabled") | sort(attribute="order") | publiclySafe %}
{% if situations.length %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading section-heading--wide">
      <h2>{{ advisory.positioningHeading }}</h2>
      {% if advisory.positioningIntro %}<p>{{ advisory.positioningIntro }}</p>{% endif %}
    </div>
    <div class="card-grid">
      {% for s in situations %}
      <a class="accent-card accent-card--{{ s.accent }}" href="/contact/?intent={{ s.contactIntent }}&topic={{ s.contactTopic }}">
        <h3>{{ s.title }}</h3>
        <p>{{ s.description }}</p>
        <span class="accent-card__link">Discuss this →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set engagementTypes = advisory.engagementTypes | selectattr("enabled") | sort(attribute="order") | publiclySafe %}
{% if engagementTypes.length %}
<section class="tier-secondary">
  <div class="wrap">
    <div class="section-heading">
      <h2>{{ advisory.engagementHeading }}</h2>
    </div>
    <div class="engagement-tiles">
      {% for e in engagementTypes %}
      {% set engagementHref = "/contact/?intent=" + e.contactIntent + "&topic=" + e.contactTopic if e.contactTopic else "/contact/?intent=" + e.contactIntent %}
      <a class="engagement-tile" href="{{ engagementHref }}">
        <h3>{{ e.title }}</h3>
        <p>{{ e.description }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set opportunities = advisory.opportunities | sort(attribute="order") %}
{% if opportunities.length %}
<section class="tier-dominant teaser">
  <div class="wrap">
    <div class="section-heading">
      <h2>{{ advisory.otherConversationsHeading }}</h2>
    </div>
    <div class="opportunity-grid">
      {% for o in opportunities %}
      <a class="opportunity-block opportunity-block--{{ o.accent }}" href="/contact/?intent={{ o.contactIntent }}">
        <span class="opportunity-block__label">{{ o.title }}</span>
        <p>{{ o.description }}</p>
        <span class="opportunity-block__cue" aria-hidden="true">→</span>
      </a>
      {% endfor %}
    </div>
    <div class="teaser__ctas" style="margin-top: 2rem;">
      <a class="btn btn--secondary" href="/speaking/">Explore Speaking →</a>
      <a class="btn btn--primary" href="/contact/">{{ advisory.finalCtaPrimaryLabel or "Start a Conversation" }} →</a>
      {{ cta.linkedinLink(advisory.linkedinCtaLabel + " →" if advisory.linkedinCtaLabel else null) }}
    </div>
  </div>
</section>
{% endif %}
